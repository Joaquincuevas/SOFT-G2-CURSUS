# Copia este archivo a .env (cp .env.example .env). El archivo .env no se versiona.
# Valores solo para desarrollo local: no uses credenciales reales aquí.

# PostgreSQL (docker-compose.yml y conexión del backend)
POSTGRES_HOST=localhost
POSTGRES_USER=cursus
POSTGRES_PASSWORD=cursus_dev
POSTGRES_DB=cursus
# Puerto en tu máquina. Cámbialo si el 5432 ya está ocupado.
POSTGRES_PORT=5432
# true para conectarse con SSL (staging en RDS). En local, false.
POSTGRES_SSL=false

# Backend (API)
# Header secreto que agrega Vercel a cada petición /api/*. Vacío en local:
# desactiva la validación. En staging lo define AWS; nunca lo escribas aquí.
ORIGIN_SECRET=
# Secreto para firmar los JWT de sesión (mínimo 32 caracteres). Este valor es solo
# para desarrollo local. En staging y production lo genera AWS Secrets Manager.
JWT_SECRET=solo-desarrollo-local-no-usar-en-aws-0000
# Duración del JWT de sesión (formato de jsonwebtoken: 15m, 1h...).
JWT_EXPIRES_IN=15m
# Duración del refresh token, que se renueva en cada uso (número y unidad s, m, h o d).
# Opcional: por defecto, 7d.
JWT_REFRESH_EXPIRES_IN=7d
# Base que crean y borran los tests de base de datos (npm run test:db --workspace=backend).
POSTGRES_TEST_DB=cursus_test

# Contraseña de todos los usuarios de prueba que crea el seed (npm run seed --workspace=backend).
SEED_PASSWORD=cursus_demo
# Solo para staging: permite correr el seed con NODE_ENV=production. No lo definas en producción.
# SEED_ALLOW=true

# Superadmin que crea npm run superadmin --workspace=backend (MT-04). Opcionales: solo
# los lee ese comando. El correo no puede ser del dominio de una universidad, y la
# contraseña es provisoria (se cambia en el primer ingreso). En AWS, la contraseña
# es el secreto cursus-<entorno>/superadmin-password (ver infra/aws/superadmin.sh).
# SUPERADMIN_CORREO=superadmin@cursus.test
# SUPERADMIN_NOMBRE=Superadmin
# SUPERADMIN_PASSWORD=
